<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <!-- 결과 텍스트뷰 -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="0"
        android:textSize="32sp"
        android:gravity="end|center_vertical"
        android:background="#EEEEEE"
        android:padding="16dp"
        android:layout_marginBottom="24dp" />

    <!-- 버튼들 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 1번째 줄: 0, 1, 2, Clear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">
            <Button android:id="@+id/button15" android:layout_width="70dp" android:layout_height="70dp" android:text="0" android:layout_margin="4dp"/>
            <Button android:id="@+id/button14" android:layout_width="70dp" android:layout_height="70dp" android:text="1" android:layout_margin="4dp"/>
            <Button android:id="@+id/button12" android:layout_width="70dp" android:layout_height="70dp" android:text="2" android:layout_margin="4dp"/>
            <Button android:id="@+id/button21" android:layout_width="70dp" android:layout_height="70dp" android:text="C" android:layout_margin="4dp"/>
        </LinearLayout>

        <!-- 2번째 줄: 3, 4, 5, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">
            <Button android:id="@+id/button" android:layout_width="70dp" android:layout_height="70dp" android:text="3" android:layout_margin="4dp"/>
            <Button android:id="@+id/button16" android:layout_width="70dp" android:layout_height="70dp" android:text="4" android:layout_margin="4dp"/>
            <Button android:id="@+id/button17" android:layout_width="70dp" android:layout_height="70dp" android:text="5" android:layout_margin="4dp"/>
            <Button android:id="@+id/button25" android:layout_width="70dp" android:layout_height="70dp" android:text="+" android:layout_margin="4dp"/>
        </LinearLayout>

        <!-- 3번째 줄: 6, 7, 8, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">
            <Button android:id="@+id/button13" android:layout_width="70dp" android:layout_height="70dp" android:text="6" android:layout_margin="4dp"/>
            <Button android:id="@+id/button19" android:layout_width="70dp" android:layout_height="70dp" android:text="7" android:layout_margin="4dp"/>
            <Button android:id="@+id/button18" android:layout_width="70dp" android:layout_height="70dp" android:text="8" android:layout_margin="4dp"/>
            <Button android:id="@+id/button26" android:layout_width="70dp" android:layout_height="70dp" android:text="-" android:layout_margin="4dp"/>
        </LinearLayout>

        <!-- 4번째 줄: 9, *, /, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/button20" android:layout_width="70dp" android:layout_height="70dp" android:text="9" android:layout_margin="4dp"/>
            <Button android:id="@+id/buttonMultiply" android:layout_width="70dp" android:layout_height="70dp" android:text="*" android:layout_margin="4dp"/>
            <Button android:id="@+id/buttonDivide" android:layout_width="70dp" android:layout_height="70dp" android:text="/" android:layout_margin="4dp"/>
            <Button android:id="@+id/buttonEqual" android:layout_width="70dp" android:layout_height="70dp" android:text="=" android:layout_margin="4dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>